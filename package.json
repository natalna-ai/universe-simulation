{
  "name": "natalna-universe-simulation",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time 3D astrology transit simulator with Swiss Ephemeris",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace packages/ephemeris-core run build && npm --workspace apps/api run build && npm --workspace apps/web run build",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:migrate:deploy": "npm --workspace apps/api run prisma:migrate:deploy"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
